#wow
calculate_bmi_category <- function(weight, height) {
bmi <- weight / height^2
if (bmi < 18.5) {
category <- "Underweight"
} else if (bmi < 25) {
category <- "Normal"
} else if (bmi < 30) {
category <- "Overweight"
} else {
category <- "Obesity"
}
category
}
calculate_bmi_category(70, 1.67)
