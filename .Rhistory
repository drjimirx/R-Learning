#exporting multiple object as sheet in single excel file
patientsdata <- data.frame(
id = 1:3,
age = c(25, 40, 65)
)
labs <- data.frame(
id = 1:3,
hemoglobin = c(14.2, 12.8, 10.5)
)
outcomes <- data.frame(
id = 1:3,
outcome = c("Good", "Good", "Poor")
)
#now we have to create three different sheet
writexl::write_xlsx(
list(
Patients = patients,
Laboratory = labs,
Outcomes = outcomes
),
"medical_research.xlsx"
)
